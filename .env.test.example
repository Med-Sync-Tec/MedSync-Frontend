# Credenciales de cuentas de prueba para los tests UAT con Playwright
# Copia este archivo a .env.test y rellena con credenciales reales de testing

# Cuenta de doctor de prueba (rol DOCTOR en Firebase)
TEST_DOCTOR_EMAIL=doctor@tudominio.com
TEST_DOCTOR_PASSWORD=contraseña_del_doctor

# Cuenta de COO de prueba (rol COO en Firebase)
TEST_COO_EMAIL=coo@tudominio.com
TEST_COO_PASSWORD=contraseña_del_coo

# URL base (opcional, por defecto apunta al dev server local)
# BASE_URL=https://medsync-frontend-xxxxx.run.app
